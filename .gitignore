# Dependencies
/node_modules/

# Angular and build output
/.angular/
/dist/
/tmp/
/out-tsc/
/bazel-out/
/coverage/
*.tsbuildinfo

# Tool caches
/.cache/
/.parcel-cache/
.eslintcache
.sass-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files
.env
.env.*
!.env.example

# IDEs and editors
/.idea/
*.iml
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Keep shared VS Code configuration, ignore everything else
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
!/.vscode/mcp.json

# Test and local tooling artifacts
__screenshots__/
/connect.lock
/libpeerconnection.log
/testem.log
/typings/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
